# ==============================================================================
# TaskVault Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# 1. Reown AppKit (WalletConnect Cloud) Project ID
# Get yours for free at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your_reown_project_id_here
REOWN_PROJECT_ID=your_reown_project_id_here

# 2. Deployer / Admin Wallet Private Key (For Bohr Testnet scripts)
# IMPORTANT: Never commit your real private key!
PRIVATE_KEY=your_private_key_here

# 3. Bohr Network Details (BOT Chain)
RPC_URL=https://rpc.bohr.life
CHAIN_ID=968
NATIVE_TOKEN=BOT
EXPLORER_URL=https://scan.bohr.life/

# 4. Optional: Custom Arbiter Wallet Address
ARBITER_ADDRESS=
